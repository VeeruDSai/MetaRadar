      "post": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Query Athena",
        "description": "Queries Athena intelligence synthesis layer with prompt sanitization, privacy gating, and honest telemetry.",
        "operationId": "query_athena_api_v1_athena_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthenaQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
