# Database & Cache Settings
DATABASE_URL=postgresql+asyncpg://metaradar:metaradar_pass@localhost:5432/metaradar
REDIS_URL=redis://localhost:6379/0

# LLM Reasoning & Fallback Configuration
LLM_PROVIDER=local
LOCAL_LLM_MODEL=google/gemma-3-4b-it
LLM_DEVICE=auto
LLM_DTYPE=int4
MAX_CONTEXT_TOKENS=2048
MAX_OUTPUT_TOKENS=512

# Optional Grok Hosted Fallback (Defaults to false)
ENABLE_GROK_FALLBACK=false
XAI_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=e4bb823e5956b6277b069d276b978c48a73507c7
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_SEQ_LENGTH=256

# Pipeline & Data Lifecycle
RAW_SIGNAL_RETENTION_DAYS=30
NEWSAPI_KEY=

# Security & CORS
CORS_ORIGINS=http://localhost:3000
