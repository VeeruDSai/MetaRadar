{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaRadar",
    "version": "5.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health",
        "description": "Liveness check: process is alive.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Ready",
        "description": "Readiness check: requires DB. Redis check is non-blocking.",
        "operationId": "get_health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/models": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Models",
        "description": "Reports provider & model initialization availability.",
        "operationId": "get_health_models_api_v1_health_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/connectors": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Connectors",
        "description": "Reports individual connector health, last success, last error, quota status.",
        "operationId": "get_health_connectors_api_v1_health_connectors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthConnectorsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "List Signals",
        "description": "Returns signals list.",
        "operationId": "list_signals_api_v1_signals_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/overview": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Get Overview",
        "description": "Returns workspace summary metrics and health overview.",
        "operationId": "get_overview_api_v1_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/athena": {
      "post": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Query Athena",
        "description": "Queries Athena intelligence synthesis layer.",
        "operationId": "query_athena_api_v1_athena_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthenaQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AthenaQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AthenaQueryRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "AthenaQueryRequest"
      },
      "AthenaQueryResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "evidence_count": {
            "type": "integer",
            "title": "Evidence Count"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "confidence",
          "evidence_count"
        ],
        "title": "AthenaQueryResponse"
      },
      "ConnectorHealthStatus": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "freshness_class": {
            "type": "string",
            "title": "Freshness Class"
          },
          "quota_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quota Remaining"
          },
          "last_success": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "name",
          "status",
          "freshness_class"
        ],
        "title": "ConnectorHealthStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthConnectorsResponse": {
        "properties": {
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorHealthStatus"
            },
            "type": "array",
            "title": "Connectors"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "connectors"
        ],
        "title": "HealthConnectorsResponse"
      },
      "HealthModelsResponse": {
        "properties": {
          "llm_provider": {
            "type": "string",
            "title": "Llm Provider"
          },
          "gemma_available": {
            "type": "boolean",
            "title": "Gemma Available"
          },
          "grok_configured": {
            "type": "boolean",
            "title": "Grok Configured"
          },
          "grok_fallback_enabled": {
            "type": "boolean",
            "title": "Grok Fallback Enabled"
          },
          "bart_degraded_available": {
            "type": "boolean",
            "title": "Bart Degraded Available"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "embedding_revision": {
            "type": "string",
            "title": "Embedding Revision"
          },
          "embedding_dimension": {
            "type": "integer",
            "title": "Embedding Dimension"
          }
        },
        "type": "object",
        "required": [
          "llm_provider",
          "gemma_available",
          "grok_configured",
          "grok_fallback_enabled",
          "bart_degraded_available",
          "embedding_model",
          "embedding_revision",
          "embedding_dimension"
        ],
        "title": "HealthModelsResponse"
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          },
          "redis_warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis Warning"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "redis"
        ],
        "title": "HealthReadyResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "MetaRadar API"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "5.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}