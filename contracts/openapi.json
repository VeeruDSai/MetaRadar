{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaRadar",
    "version": "5.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health",
        "description": "Liveness check: process is alive.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Ready",
        "description": "Readiness check: requires DB. Redis check is non-blocking.",
        "operationId": "get_health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/models": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Models",
        "description": "Reports provider & model initialization availability.",
        "operationId": "get_health_models_api_v1_health_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/connectors": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Connectors",
        "description": "Reports each live connector's honest status (D-22).\n\nReads the latest ConnectorState row per source for accurate\nlast_success / quota_remaining in ONE batched query (avoids one DB\nconnection attempt per connector); degrades to in-memory state when the\nDB is unavailable so the endpoint never fabricates values or 500s on\nauxiliary failure (fail-degrade pattern per signals.py).",
        "operationId": "get_health_connectors_api_v1_health_connectors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthConnectorsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "List Signals",
        "description": "Returns signals list.",
        "operationId": "list_signals_api_v1_signals_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/overview": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Get Overview",
        "description": "Returns workspace summary metrics and health overview.",
        "operationId": "get_overview_api_v1_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/athena": {
      "post": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Query Athena",
        "description": "Queries Athena intelligence synthesis layer.",
        "operationId": "query_athena_api_v1_athena_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthenaQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AthenaQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pipeline/run": {
      "post": {
        "tags": [
          "Pipeline Execution"
        ],
        "summary": "Trigger LangGraph 10-Node Intelligence Engine Run",
        "description": "Executes the full 10-node stateful LangGraph pipeline (node_ingest -> node_calibrate -> END).",
        "operationId": "trigger_pipeline_run_api_v1_pipeline_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PipelineRunRequestSchema"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pipeline/status/{pipeline_run_id}": {
      "get": {
        "tags": [
          "Pipeline Execution"
        ],
        "summary": "Get Pipeline Run Status",
        "description": "Retrieves execution status and telemetry for a specific pipeline_run_id.",
        "operationId": "get_pipeline_run_status_api_v1_pipeline_status__pipeline_run_id__get",
        "parameters": [
          {
            "name": "pipeline_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pipeline Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Pipeline Run Status Api V1 Pipeline Status  Pipeline Run Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AthenaQueryRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "AthenaQueryRequest"
      },
      "AthenaQueryResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "evidence_count": {
            "type": "integer",
            "title": "Evidence Count"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "confidence",
          "evidence_count"
        ],
        "title": "AthenaQueryResponse"
      },
      "ConnectorHealthStatus": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "freshness_class": {
            "type": "string",
            "title": "Freshness Class"
          },
          "quota_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quota Remaining"
          },
          "last_success": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "name",
          "status",
          "freshness_class"
        ],
        "title": "ConnectorHealthStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthConnectorsResponse": {
        "properties": {
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorHealthStatus"
            },
            "type": "array",
            "title": "Connectors"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "connectors"
        ],
        "title": "HealthConnectorsResponse"
      },
      "HealthModelsResponse": {
        "properties": {
          "llm_provider": {
            "type": "string",
            "title": "Llm Provider"
          },
          "gemma_available": {
            "type": "boolean",
            "title": "Gemma Available"
          },
          "grok_configured": {
            "type": "boolean",
            "title": "Grok Configured"
          },
          "grok_fallback_enabled": {
            "type": "boolean",
            "title": "Grok Fallback Enabled"
          },
          "bart_degraded_available": {
            "type": "boolean",
            "title": "Bart Degraded Available"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "embedding_revision": {
            "type": "string",
            "title": "Embedding Revision"
          },
          "embedding_dimension": {
            "type": "integer",
            "title": "Embedding Dimension"
          }
        },
        "type": "object",
        "required": [
          "llm_provider",
          "gemma_available",
          "grok_configured",
          "grok_fallback_enabled",
          "bart_degraded_available",
          "embedding_model",
          "embedding_revision",
          "embedding_dimension"
        ],
        "title": "HealthModelsResponse"
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          },
          "redis_warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis Warning"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "redis"
        ],
        "title": "HealthReadyResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "MetaRadar API"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "5.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "PipelineRunRequestSchema": {
        "properties": {
          "batch_size": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "description": "Max bronze signals to process",
            "default": 50
          },
          "calibration_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibration Weights",
            "description": "Optional runtime role weight overrides"
          }
        },
        "type": "object",
        "title": "PipelineRunRequestSchema"
      },
      "PipelineRunResponseSchema": {
        "properties": {
          "pipeline_run_id": {
            "type": "string",
            "title": "Pipeline Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "signals_processed": {
            "type": "integer",
            "title": "Signals Processed"
          },
          "role_briefs_count": {
            "type": "integer",
            "title": "Role Briefs Count"
          },
          "developments_count": {
            "type": "integer",
            "title": "Developments Count"
          },
          "confluence_stories_count": {
            "type": "integer",
            "title": "Confluence Stories Count"
          },
          "contradictions_count": {
            "type": "integer",
            "title": "Contradictions Count"
          },
          "missing_signals_count": {
            "type": "integer",
            "title": "Missing Signals Count"
          },
          "node_statuses": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Node Statuses"
          },
          "errors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Errors"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "pipeline_run_id",
          "status",
          "signals_processed",
          "role_briefs_count",
          "developments_count",
          "confluence_stories_count",
          "contradictions_count",
          "missing_signals_count",
          "node_statuses"
        ],
        "title": "PipelineRunResponseSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}