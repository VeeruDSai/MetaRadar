{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaRadar",
    "version": "5.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health",
        "description": "Liveness check: process is alive.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Ready",
        "description": "Readiness check: requires DB. Redis check is non-blocking.",
        "operationId": "get_health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/models": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Models",
        "description": "Reports real provider & model initialization availability. No fabricated telemetry.",
        "operationId": "get_health_models_api_v1_health_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/connectors": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Get Health Connectors",
        "description": "Reports each live connector's honest status (D-22).\n\nReads the latest ConnectorState row per source for accurate\nlast_success / quota_remaining in ONE batched query (avoids one DB\nconnection attempt per connector); degrades to in-memory state when the\nDB is unavailable so the endpoint never fabricates values or 500s on\nauxiliary failure (fail-degrade pattern per signals.py).",
        "operationId": "get_health_connectors_api_v1_health_connectors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthConnectorsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "List Signals",
        "description": "Returns signals list with deterministic ordering, limit/offset pagination, and total count.",
        "operationId": "list_signals_api_v1_signals_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/overview": {
      "get": {
        "tags": [
          "Signals & Intelligence"
        ],
        "summary": "Get Overview",
        "description": "Returns workspace summary metrics, dynamic database aggregations, and measured health latency.",
        "operationId": "get_overview_api_v1_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          }
        }
      }
    },
